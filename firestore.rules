rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Catálogo institucional público (só leitura)
    match /modulos_saude/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /videos_biblioteca/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /recompensas/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 2. Perfis: dados clínicos ligados a um id aleatório (sem identificação pessoal).
    //    donoUid = UID anónimo do Firebase Auth. cuidadoresUids = UIDs autorizados (preenchido
    //    pelo fluxo de convite). Cada instalação só vê os seus perfis e os que lhe foram partilhados.
    match /perfis/{idPerfil} {
      // As consultas da app filtram por donoUid ou por cuidadoresUids, por isso a regra tem de
      // usar exatamente esses campos (o dono é avaliado primeiro).
      allow read: if request.auth != null && (
        resource.data.donoUid == request.auth.uid ||
        request.auth.uid in resource.data.cuidadoresUids
      );

      // Criar: o dono tem de ser o próprio utilizador
      allow create: if request.auth != null
        && request.resource.data.donoUid == request.auth.uid;

      // Atualizar: o dono pode alterar tudo menos o dono; um cuidador pode alterar dados
      // clínicos mas não o dono nem a lista de cuidadores.
      allow update: if request.auth != null
        && request.resource.data.donoUid == resource.data.donoUid
        && (
          resource.data.donoUid == request.auth.uid ||
          (
            request.auth.uid in resource.data.get('cuidadoresUids', []) &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['donoUid', 'cuidadoresUids'])
          )
        );

      // Apagar: só o dono
      allow delete: if request.auth != null && resource.data.donoUid == request.auth.uid;

      // Subcoleções (medicamentos, consultas, notas): dono ou cuidador autorizado
      match /{subcolecao}/{docSubId} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/perfis/$(idPerfil)).data.donoUid == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/perfis/$(idPerfil)).data.get('cuidadoresUids', [])
        );
      }
    }
  }
}
